{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y -p npm:@peri-code/hindsight@0.8.0 hindsight hook session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y -p npm:@peri-code/hindsight@0.8.0 hindsight hook recall",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y -p npm:@peri-code/hindsight@0.8.0 hindsight hook retain",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y -p npm:@peri-code/hindsight@0.8.0 hindsight hook session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
